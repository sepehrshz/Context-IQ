generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id           String          @id @default(cuid())
  originalName String
  savedName    String
  path         String
  mimeType     String
  size         Int
  hash         String          @unique
  status       DocumentStatus? @default(UPLOADED)
  createdAt    DateTime?       @default(now())
  updatedAt    DateTime?       @updatedAt
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}
